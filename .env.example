# Copy to .env (never commit .env). Loaded by backend/run.py.
HMRN_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0
PORT=5000

# SQLite by default; any SQLAlchemy URL works
HMRN_DATABASE_URL=sqlite:///instance/hmrn.db
HMRN_UPLOAD_FOLDER=instance/uploads

# Google Gemini (server-side only). Leave empty to use the rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tesseract binary path if not on PATH (e.g. Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# CORS origin of the dev frontend; in production serve frontend/dist from Flask
HMRN_FRONTEND_ORIGIN=http://localhost:5173
HMRN_COOKIE_SECURE=0
HMRN_EMERGENCY_ACCESS_MINUTES=60
